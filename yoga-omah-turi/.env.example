# Supabase (Project Settings -> API). Service role HANYA dipakai di server, jangan diberi prefix NEXT_PUBLIC
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# Rekening tujuan transfer
BANK_NAME=BCA
BANK_ACCOUNT=1234567890
BANK_HOLDER=Nama Pemilik Rekening

# Nomor WhatsApp admin (format 628xxxxxxxxxx, tanpa + atau spasi)
WA_NUMBER=6281234567890

# Password halaman /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Opsional
MIN_DONATION=1000        # minimal donasi sukarela (Kamis)
TICKET_PRICE=50000        # harga tiket Jumat per orang
DEFAULT_QUOTA=20          # kuota otomatis untuk tanggal Kamis/Jumat baru
HOLD_MINUTES=180
