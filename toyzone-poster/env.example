# ── WAJIB ──
# Password untuk masuk dashboard (berikan ke owner)
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Kunci acak untuk sesi login & cron (isi teks acak panjang, beda satu sama lain)
SESSION_SECRET=isi-teks-acak-panjang-1
CRON_SECRET=isi-teks-acak-panjang-2
# Website Toyzone (sumber data produk)
STORE_URL=https://toyzone-preview.netlify.app
# Supabase — supabase.com → Project Settings → API (jalankan schema.sql dulu)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# ── OPSIONAL: sumber caption AI ──
# Pilih salah satu. Semua kosong = caption dari template (gratis, tanpa AI).
#
# A) FreeLLMAPI (gratis) — https://github.com/tashfeenahmed/freellmapi
#    Harus dijalankan di server yang menyala 24 jam & bisa diakses dari internet.
FREELLM_BASE_URL=
#    Kunci "freellmapi-..." dari halaman Keys di dashboard FreeLLMAPI
FREELLM_API_KEY=
#    auto | auto:fast | auto:smart | nama model tertentu
FREELLM_MODEL=auto
#
# B) Claude (console.anthropic.com), bayar per pemakaian
ANTHROPIC_API_KEY=
#
# Paksa pilihan: freellm | claude | template (kosong = otomatis)
# CAPTION_PROVIDER=
# Ganti model kalau perlu, default claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5
# Alamat aplikasi ini (untuk link gambar ke Instagram). Kosong = otomatis.
# APP_URL=https://toyzone-poster.netlify.app
